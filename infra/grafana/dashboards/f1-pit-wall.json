    {
      "id": 15,
      "type": "table",
      "title": "Pit stops (current race)",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawSql": "SELECT p.lap_number AS \"Lap\", p.driver_code AS \"Driver\", e.team_name AS \"Team\", round(p.pit_lane_time_ms / 1000.0, 1) AS \"Pit lane (s)\", round(p.stationary_time_ms / 1000.0, 2) AS \"Stop (s)\", p.compound_out AS \"New tyre\" FROM pit_stops p JOIN race_entries e USING (race_id, driver_code) WHERE p.race_id = (SELECT max(id) FROM races) ORDER BY p.lap_number DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "New tyre"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "SOFT": {
                        "color": "red",
                        "text": "SOFT",
                        "index": 0
                      },
                      "MEDIUM": {
                        "color": "yellow",
                        "text": "MEDIUM",
                        "index": 1
                      },
                      "HARD": {
                        "color": "#e0e0e0",
                        "text": "HARD",
                        "index": 2
                      },
                      "INTERMEDIATE": {
                        "color": "green",
                        "text": "INTER",
                        "index": 3
                      },
                      "WET": {
                        "color": "blue",
                        "text": "WET",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
