    {
      "id": 16,
      "type": "barchart",
      "title": "Average pit lane time by team (all races)",
      "gridPos": {
        "x": 12,
        "y": 37,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawSql": "SELECT e.team_name AS \"Team\", round(avg(p.pit_lane_time_ms) / 1000.0, 2) AS \"Seconds\" FROM pit_stops p JOIN race_entries e USING (race_id, driver_code) GROUP BY e.team_name ORDER BY 2",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#ff8000"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "Team",
        "orientation": "horizontal",
        "showValue": "always",
        "legend": {
