    {
      "id": 8,
      "type": "table",
      "title": "Live classification",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 15
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawSql": "SELECT position AS \"Pos\", driver_code AS \"Driver\", team_name AS \"Team\", laps AS \"Lap\", gap_s AS \"Gap (s)\", last_lap_s AS \"Last lap (s)\", compound AS \"Tyre\", tyre_age AS \"Age\", tyre_wear AS \"Wear %\", pit_stops AS \"Stops\" FROM v_live_standings",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Tyre"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "SOFT": {
                        "color": "red",
                        "text": "SOFT",
                        "index": 0
                      },
                      "MEDIUM": {
                        "color": "yellow",
                        "text": "MEDIUM",
                        "index": 1
                      },
                      "HARD": {
                        "color": "#e0e0e0",
                        "text": "HARD",
                        "index": 2
                      },
                      "INTERMEDIATE": {
                        "color": "green",
                        "text": "INTER",
                        "index": 3
                      },
                      "WET": {
                        "color": "blue",
                        "text": "WET",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Wear %"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "lcd"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 50
                    },
                    {
                      "color": "red",
                      "value": 75
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Driver"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ffffff"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pos"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 50
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": []
    },
