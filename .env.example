# Copy to .env (or run `make env` to generate random secrets). Never commit .env.

# --- gateway ---
GATEWAY_PORT=8080

# --- race data source: "replay" (real races from OpenF1, falls back to simulation) or "simulation"
RACE_SOURCE=replay
REPLAY_RACES=2024:Monza,2024:Silverstone,2024:Spa-Francorchamps
SPEED_FACTOR=20

# --- PostgreSQL ---
POSTGRES_DB=f1
POSTGRES_USER=f1
POSTGRES_PASSWORD=change-me
GRAFANA_DB_PASSWORD=change-me
API_DB_PASSWORD=change-me
EXPORTER_DB_PASSWORD=change-me

# --- RabbitMQ ---
RABBITMQ_USER=f1
RABBITMQ_PASSWORD=change-me

# --- authorization server ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=120
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Grafana internal admin (not used for login: auth goes through the gateway) ---
GRAFANA_ADMIN_PASSWORD=change-me
